# Скопируй в .env и заполни. Секреты (токены, ключи) — ТОЛЬКО здесь, не в коде/гите.

# ── Telegram Bot ───────────────────────────────────────────────
# Токен от @BotFather
RENTRADAR_BOT_TOKEN=
# ID/username публичного канала (бот должен быть админом), напр. @flatslike или -100...
RENTRADAR_PUBLIC_CHANNEL=
# Приватный канал (не используется на MVP, можно пусто)
RENTRADAR_PRIVATE_CHANNEL=
# Числовой id главного админа (узнать через @userinfobot) — на него идут алерты
RENTRADAR_ADMIN_ID=
# Доп. админы через запятую: "111,222"
RENTRADAR_ADMIN_IDS=
# Годовой OAuth-токен Claude Code (на компе: claude setup-token) для команды /cc.
# Пусто = /cc выключен. От подписки Claude.ai, без API-биллинга. БЕЗ угловых скобок!
RENTRADAR_CLAUDE_TOKEN=

# ── Поведение ──────────────────────────────────────────────────
# Сухой режим: не постить в Telegram, только логировать (для отладки)
RENTRADAR_DRY_RUN=true
RENTRADAR_DB_PATH=data/rentradar.db
RENTRADAR_PROFILES_PATH=profiles.yaml
RENTRADAR_EMOJI_PATH=emoji.json
RENTRADAR_LOG_LEVEL=INFO

# Часы публичного постинга (MSK, через запятую) — 3 слота-пика. Пусто → почасовой.
RENTRADAR_PUBLIC_POST_HOURS=10,14,20
# Разброс времени постинга ±сек (не ровно в HH:00, чтобы не палиться). 300 = ±5 мин.
RENTRADAR_PUBLIC_POST_JITTER_SEC=300
RENTRADAR_POLL_INTERVAL_MIN=60
# Окно «свежести» для публичного топа, часов
RENTRADAR_PUBLIC_LOOKBACK_HOURS=12
# Частота сбора площадок, минут
RENTRADAR_COLLECT_INTERVAL_MIN=5
# Окно расчёта рыночных медиан, дней
RENTRADAR_MARKET_WINDOW_DAYS=90
# Пауза между постами (антифлуд Telegram), сек
RENTRADAR_POST_DELAY_SEC=3.0
# Максимум постов за слот (1 × 3 слота = 3/день — оптимум по охвату)
RENTRADAR_MAX_POSTS_PER_RUN=1
# Фото в посте: личка / канал
RENTRADAR_MAX_PHOTOS_PERSONAL=7
RENTRADAR_MAX_PHOTOS_PUBLIC=5
# CTA в конце поста. В КАНАЛЕ → на бота, в ЛИЧКЕ → на публичный канал (пустой URL → без строки).
RENTRADAR_CTA_TEXT=FlatLikeThat — найти квартиру
RENTRADAR_CTA_URL=https://t.me/FlatLike_bot
RENTRADAR_CTA_PUBLIC_TEXT=FlatLikeThat — найти квартиру
RENTRADAR_CTA_PUBLIC_URL=https://t.me/flatslike

# ── Авито ──────────────────────────────────────────────────────
# HTTP-прокси/web-unblocker для Авито: "http://user:pass@host:port".
# Пусто = напрямую (ОК на домашнем IP; НА VPS ОБЯЗАТЕЛЕН — Авито банит дата-центры).
RENTRADAR_AVITO_PROXY=
# Дообогащение с детальной страницы: кап за проход (0 = выключить) и пауза, сек
RENTRADAR_AVITO_DETAIL_MAX_PER_RUN=8
RENTRADAR_AVITO_DETAIL_DELAY_SEC=8.0

# ── Персональный (платный) бот ─────────────────────────────────
# Пробник: 24 часа после проверки канала. Старый FREE_SENDS_LIMIT не используется.
RENTRADAR_MAX_FILTERS_PER_USER=3
# Окно свежести для матчинга, часов (168 = 7 дней; повторов нет — дедуп по was_sent)
RENTRADAR_PERSONAL_LOOKBACK_HOURS=168
# Две дорожки рассылки: свежие (в моменте) шлём без очереди, старый бэклог мягко
RENTRADAR_PERSONAL_FRESH_MAX=15
RENTRADAR_PERSONAL_BACKLOG_PER_CHECK=5
# Первый показ нового фильтра: сколько свежайших сразу (остальное уйдёт бэклогом)
RENTRADAR_PERSONAL_COLD_START_LIMIT=12
# Защита контента от кражи (запрет пересылки/сохранения). В боте — да, в канале —
# осторожно (убивает пересылки=рост), поэтому по умолчанию только бот.
RENTRADAR_PROTECT_CONTENT_BOT=true
RENTRADAR_PROTECT_CONTENT_PUBLIC=false
# Ручная оплата: /paid <telegram_id> <24h|3d|7d|30d> <operation_id> (только admins).
# Каталог в personal/access.py: 24 ч / 49 ₽, 72 ч / 129 ₽, 168 ч / 249 ₽, 720 ч / 590 ₽.
# Legacy provider token и SUB_PRICE_RUB/SUB_DAYS не управляют новым сценарием.
# Контакт поддержки и ручной оплаты (укажи свой действующий контакт).
RENTRADAR_ADMIN_CONTACT=@ol1nn4
# Рефералы фиксированы: +12 часов за активного друга, +48 за первую оплату.
# Пауза подписки: максимум дней заморозки
RENTRADAR_PAUSE_MAX_DAYS=2
# Отдельный бонус за канал заменён единым пробником, не продлеваемым паузой.
# Lifecycle-напоминания: не раньше чем за N дней до конца оплаты (короткие тарифы —
# ~15% срока), сколько дней после конца уместно напомнить, за сколько часов
# предупредить о конце пробника; прогон ежечасно в эти часы MSK (ночью тишина).
RENTRADAR_LIFECYCLE_EXPIRY_DAYS=3
RENTRADAR_LIFECYCLE_WINBACK_DAYS=7
RENTRADAR_LIFECYCLE_TRIAL_SOON_HOURS=4
RENTRADAR_LIFECYCLE_HOURS=9-22

# ── Vision (анализ фото) ───────────────────────────────────────
# Ключ Polza AI (или другого OpenAI-совместимого провайдера). Пусто = vision выключен —
# тогда поставь RENTRADAR_PUBLIC_REQUIRE_ANALYZED=false, иначе канал будет голодать!
RENTRADAR_VISION_API_KEY=
RENTRADAR_VISION_BASE_URL=https://api.polza.ai/api/v1
RENTRADAR_VISION_MODEL=google/gemini-2.5-flash-lite
# Кап фото в вызове / лотов за проход / частота прохода, мин
RENTRADAR_VISION_MAX_IMAGES=12
RENTRADAR_VISION_MAX_PER_RUN=15
RENTRADAR_VISION_INTERVAL_MIN=5
# Не анализировать лоты со скором ниже (0 = анализировать всё)
RENTRADAR_VISION_MIN_SCORE=48
# В канал только vision-проверенные лоты (анти-скам). false — если vision выключен.
RENTRADAR_PUBLIC_REQUIRE_ANALYZED=true
# WOW-порог красоты для канала (0 = не фильтровать). Канал = витрина-приманка.
RENTRADAR_PUBLIC_MIN_APPEAL=75
# Потолок цены для канала, ₽/мес (0 = без потолка). Красивые и сильно дешевле
# рынка (порог showcase_max_discount, по умолчанию 30%) в канал не идут: приманка.
RENTRADAR_PUBLIC_MAX_PRICE=100000
# Ранжировать канал по красоте (appeal), а не по «вкусности» — лучшие сделки боту.
RENTRADAR_PUBLIC_RANK_BY_APPEAL=true
# Порог вкусности для канала (0 = не требовать сделку; лучшие сделки бережём боту)
RENTRADAR_PUBLIC_MIN_SCORE=0
# Показывать оценку ремонта в постах (ведём скрыто)
RENTRADAR_SHOW_RENOVATION_IN_POST=false

# Relay вместо api.telegram.org (Cloudflare Worker, см. deploy/README.md); пусто = напрямую
RENTRADAR_TELEGRAM_API_BASE=

# Выключить Авито (например, пока IP сервера в бане)
RENTRADAR_AVITO_ENABLED=true
# Мобильный прокси для Авито (телефон через Tailscale exit node), см. deploy/README.md
RENTRADAR_AVITO_BROWSER_WARMUP=false
RENTRADAR_AVITO_ROTATE_CMD=
RENTRADAR_AVITO_PHONE_CHECK_CMD=
